generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  ALLOCATED
  PICKING
  PACKED
  SHIPPED
  CANCELLED
}

enum PickListStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  DELIVERED
  FAILED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
}

enum ReturnStatus {
  RECEIVED
  INSPECTING
  RESOLVED
}

enum ReturnAction {
  RESTOCK
  DISPOSE
}

model Merchant {
  id           String    @id @default(uuid())
  name         String
  contactEmail String
  contactPhone String?
  billingTerms String?
  status       String    @default("active")
  products     Product[]
  orders       Order[]
  invoices     Invoice[]
  createdAt    DateTime  @default(now())
}

model Product {
  id          String       @id @default(uuid())
  merchantId  String
  merchant    Merchant     @relation(fields: [merchantId], references: [id])
  sku         String
  name        String
  barcode     String?
  weightKg    Float?
  category    String?
  inventory   Inventory[]
  orderItems  OrderItem[]
  returnItems ReturnItem[]
  createdAt   DateTime     @default(now())

  @@unique([merchantId, sku])
}

model Location {
  id            String         @id @default(uuid())
  zone          String
  aisle         String
  binCode       String         @unique
  type          String         @default("picking")
  inventory     Inventory[]
  pickListItems PickListItem[]
}

model Inventory {
  id            String    @id @default(uuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  locationId    String
  location      Location  @relation(fields: [locationId], references: [id])
  quantity      Int       @default(0)
  reservedQty   Int       @default(0)
  lastCountedAt DateTime?

  @@unique([productId, locationId])
}

model Order {
  id              String      @id @default(uuid())
  merchantId      String
  merchant        Merchant    @relation(fields: [merchantId], references: [id])
  channel         String
  externalOrderNo String?
  customerName    String
  customerAddress String
  status          OrderStatus @default(PENDING)
  items           OrderItem[]
  pickList        PickList?
  shipments       Shipment[]
  returns         Return[]
  createdAt       DateTime    @default(now())
}

model OrderItem {
  id            String         @id @default(uuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id])
  productId     String
  product       Product        @relation(fields: [productId], references: [id])
  qty           Int
  unitPrice     Decimal        @db.Decimal(10, 2)
  pickListItems PickListItem[]
}

model PickList {
  id         String         @id @default(uuid())
  orderId    String         @unique
  order      Order          @relation(fields: [orderId], references: [id])
  assignedTo String?
  assignee   User?          @relation(fields: [assignedTo], references: [id])
  status     PickListStatus @default(PENDING)
  items      PickListItem[]
  createdAt  DateTime       @default(now())
}

model PickListItem {
  id          String    @id @default(uuid())
  pickListId  String
  pickList    PickList  @relation(fields: [pickListId], references: [id])
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  locationId  String
  location    Location  @relation(fields: [locationId], references: [id])
  pickedQty   Int       @default(0)
}

model Shipment {
  id         String         @id @default(uuid())
  orderId    String
  order      Order          @relation(fields: [orderId], references: [id])
  courier    String
  trackingNo String?
  status     ShipmentStatus @default(PENDING)
  shippedAt  DateTime?
}

model Invoice {
  id          String        @id @default(uuid())
  merchantId  String
  merchant    Merchant      @relation(fields: [merchantId], references: [id])
  invoiceNo   String        @unique
  periodStart DateTime
  periodEnd   DateTime
  totalAmount Decimal       @db.Decimal(12, 2)
  status      InvoiceStatus @default(DRAFT)
  items       InvoiceItem[]
  issuedAt    DateTime?
  createdAt   DateTime      @default(now())
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  description String
  qty         Int
  unitPrice   Decimal @db.Decimal(10, 2)
  amount      Decimal @db.Decimal(10, 2)
}

model Return {
  id         String       @id @default(uuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id])
  reason     String
  status     ReturnStatus @default(RECEIVED)
  items      ReturnItem[]
  receivedAt DateTime     @default(now())
}

model ReturnItem {
  id        String       @id @default(uuid())
  returnId  String
  return    Return       @relation(fields: [returnId], references: [id])
  productId String
  product   Product      @relation(fields: [productId], references: [id])
  qty       Int
  condition String
  action    ReturnAction
}

model Role {
  id          String @id @default(uuid())
  name        String @unique // WAREHOUSE_STAFF, ADMIN_CS, SUPERVISOR, ACCOUNTING, OWNER
  permissions Json
  users       User[]
}

model User {
  id           String        @id @default(uuid())
  roleId       String
  role         Role          @relation(fields: [roleId], references: [id])
  name         String
  email        String        @unique
  passwordHash String
  status       String        @default("active")
  pickLists    PickList[]
  activityLogs ActivityLog[]
  createdAt    DateTime      @default(now())
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())
}
